APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=zapzone_cache

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_SCHEME=tcp
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

BOOKING_RULES_ADD_ON_QUANTITY=log
BOOKING_RULES_EXCLUSIVE_SLOTS=enforce
BOOKING_RULES_FORCED_ADD_ONS=log
BOOKING_RULES_CAPACITY=log
BOOKING_RULES_PACKAGE_REQUIRED=log
BOOKING_RULES_CSV_PARTICIPANTS=log

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# The public web address customers use. Every emailed and texted link — waivers, photo
# pages, receipts — is built from this, so a wrong value sends links that reach nobody.
FRONTEND_URL=http://localhost:5173

# Text messaging. All three are required before any SMS is sent; with any of them missing
# the system records the message as skipped and explains why instead of failing silently.
TWILIO_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

REGISTRATION_REQUIRE_TOKEN=false
REGISTRATION_REQUIRE_STAFF_TO_INVITE=false
REGISTRATION_TOKEN_TTL_DAYS=0
REGISTRATION_SELF_REGISTERED_STATUS=active
AUTH_BLOCK_INACTIVE_LOGIN=false

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

CHECKOUT_ENFORCE_SERVER_TOTAL=false
CHECKOUT_ENFORCE_FOR_STAFF=false
CHECKOUT_ENFORCE_CHARGE_WITHIN_DUE=false
WAIVER_RETURNING_ENABLED=false
CHECKOUT_TOTAL_TOLERANCE=0.05
CHECKOUT_MEMBERSHIP_HARDENING=log

CATALOG_RULES_MODE=log

MEDIA_EXCLUDE_HEAVY_COLUMNS=true
MEDIA_DOWNSCALE_ENABLED=false
